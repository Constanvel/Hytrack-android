<?xml version="1.0" encoding="utf-8"?>
<!-- .demo-controls: dashed fieldset whose legend sits on the top border. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="20dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_demo_controls"
        android:paddingStart="14dp"
        android:paddingTop="16dp"
        android:paddingEnd="14dp"
        android:paddingBottom="14dp">

        <TextView
            android:id="@+id/demoAction"
            style="@style/Widget.HyTrack.Button"
            tools:text="Simulasikan konfirmasi petugas" />
    </FrameLayout>

    <TextView
        android:id="@+id/demoLegend"
        style="@style/Text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:background="@color/bg"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:textColor="@color/muted"
        android:textSize="11sp"
        tools:text="Kontrol demo · menggantikan konfirmasi petugas" />
</FrameLayout>
