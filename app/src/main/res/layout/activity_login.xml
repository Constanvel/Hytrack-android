<?xml version="1.0" encoding="utf-8"?>
<!-- Sign-in (features/auth/login.tsx, Figma 00a · Login). -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipChildren="true">

        <!-- background: wave-mint at the bottom, 24px under the gesture bar. -->
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="170dp"
            android:layout_gravity="bottom"
            android:layout_marginBottom="-24dp"
            android:importantForAccessibility="no"
            android:scaleType="fitXY"
            android:src="@drawable/wave_mint"
            tools:ignore="ContentDescription" />

        <LinearLayout
            android:id="@+id/main"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:divider="@drawable/gap_32"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="32dp"
            android:paddingEnd="24dp"
            android:paddingBottom="116dp"
            android:showDividers="middle">

            <include
                android:id="@+id/identity"
                layout="@layout/view_auth_identity" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:divider="@drawable/gap_16"
                android:orientation="vertical"
                android:showDividers="middle">

                <!-- Masuk sebagai: two role cards, filled in by LoginActivity. -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:divider="@drawable/gap_8"
                    android:orientation="vertical"
                    android:showDividers="middle">

                    <TextView
                        style="@style/Text.Auth"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:accessibilityHeading="true"
                        android:fontFamily="@font/inter_semibold"
                        android:lineHeight="20sp"
                        android:text="@string/masuk_sebagai"
                        android:textSize="14sp" />

                    <LinearLayout
                        android:id="@+id/roles"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:divider="@drawable/gap_12"
                        android:orientation="horizontal"
                        android:showDividers="middle" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:divider="@drawable/gap_18"
                    android:orientation="vertical"
                    android:showDividers="middle">

                    <include
                        android:id="@+id/phone"
                        layout="@layout/view_auth_field" />

                    <include
                        android:id="@+id/password"
                        layout="@layout/view_auth_field" />
                </LinearLayout>

                <TextView
                    android:id="@+id/forgot"
                    style="@style/Text.Auth.Link"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:text="@string/lupa_kata_sandi" />

                <TextView
                    android:id="@+id/forgotNotice"
                    style="@style/Widget.HyTrack.Notice"
                    android:text="@string/account_help"
                    android:visibility="gone" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:divider="@drawable/gap_8"
                    android:orientation="vertical"
                    android:showDividers="middle">

                    <TextView
                        android:id="@+id/submit"
                        style="@style/Widget.HyTrack.AuthSubmit"
                        android:layout_height="52dp"
                        android:text="@string/masuk" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:paddingTop="10dp"
                        android:paddingBottom="10dp">

                        <TextView
                            android:id="@+id/switchPrompt"
                            style="@style/Text.Auth"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:lineHeight="20sp"
                            android:text="@string/belum_punya_akun"
                            android:textColor="@color/brand_muted"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/switchLink"
                            style="@style/Text.Auth.Link"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="5dp"
                            android:text="@string/daftar_sekarang" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:divider="@drawable/gap_16"
                android:orientation="vertical"
                android:showDividers="middle">

                <LinearLayout
                    android:id="@+id/benefit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_auth_benefit"
                    android:divider="@drawable/gap_8"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:showDividers="middle">

                    <TextView
                        style="@style/Text.Auth"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:accessibilityHeading="true"
                        android:fontFamily="@font/inter_semibold"
                        android:lineHeight="20sp"
                        android:text="@string/satu_akun_perjalanan_lebih_tenang"
                        android:textColor="@color/brand"
                        android:textSize="14sp" />

                    <TextView
                        style="@style/Text.Auth"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:lineHeight="18sp"
                        android:text="@string/ambil_antrean_pantau_kunjungan_dan"
                        android:textColor="@color/auth_benefit_text"
                        android:textSize="13sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/contact"
                    style="@style/Text.Auth.Link"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter_medium"
                    android:gravity="center"
                    android:lineHeight="18sp"
                    android:text="@string/butuh_bantuan_hubungi_petugas"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/contactNotice"
                    style="@style/Widget.HyTrack.Notice"
                    android:text="@string/account_help"
                    android:visibility="gone" />

                <!-- Login · Petugas dan Manajemen (Figma 47:2345); hidden on that screen itself. -->
                <TextView
                    android:id="@+id/internalLink"
                    style="@style/Text.Auth.Link"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter_medium"
                    android:gravity="center"
                    android:lineHeight="18sp"
                    android:minHeight="44dp"
                    android:text="@string/masuk_petugas_manajemen"
                    android:textSize="13sp" />

                <TextView
                    style="@style/Widget.HyTrack.Notice.Info"
                    android:text="@string/akun_demo_pasien_0812_5550_0842_kata" />

                <include
                    android:id="@+id/prototype"
                    layout="@layout/view_prototype" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</androidx.core.widget.NestedScrollView>
