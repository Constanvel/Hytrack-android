<?xml version="1.0" encoding="utf-8"?>
<!-- .notification-list li.card: the message is inline, so only the action line is spaced. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:id="@+id/time"
        style="@style/Text.Eyebrow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        tools:text="15 Nov · 16.47 · BARU" />

    <TextView
        android:id="@+id/message"
        style="@style/Text.Strong"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:lineHeight="18sp"
        tools:text="Obat siap diambil. Nomor pengambilan F-091." />

    <TextView
        android:id="@+id/action"
        style="@style/Text.Small.Muted"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        tools:text="Farmasi Loket F2 · Gedung A, lantai 1" />
</LinearLayout>
