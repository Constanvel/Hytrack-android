<?xml version="1.0" encoding="utf-8"?>
<!-- Tiket kunjungan (features/patient/visit.tsx: Visit, stage "booked"). -->
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:orientation="vertical"
    tools:parentTag="android.widget.LinearLayout">

    <TextView
        style="@style/Widget.HyTrack.Notice"
        android:text="@string/antrean_berhasil_diambil" />

    <!-- .card.marked.ticket-card, with the "+" badge and the pulse line (Figma 43:2 frame 04). -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

    <LinearLayout
        style="@style/Widget.HyTrack.Card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_card_marked"
        android:paddingStart="22dp"
        android:paddingTop="22dp"
        android:paddingEnd="22dp"
        android:paddingBottom="22dp">

        <TextView
            style="@style/Text.Eyebrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/nomor_antrean_anda" />

        <TextView
            android:id="@+id/ticket"
            style="@style/Text.Ticket"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="A-027" />

        <TextView
            android:id="@+id/patient"
            style="@style/Text.H3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="Siti Aminah" />

        <View style="@style/Widget.HyTrack.Hr" />

        <TextView
            android:id="@+id/clinic"
            style="@style/Text.H3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="Penyakit Dalam" />

        <TextView
            android:id="@+id/schedule"
            style="@style/Text.P.Muted"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="dr. Rina Kusuma, Sp.PD\nMinggu, 15 November 2026 · 09.00–12.00" />
    </LinearLayout>

        <TextView
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_gravity="top|end"
            android:layout_marginTop="74dp"
            android:layout_marginEnd="27dp"
            android:background="@drawable/bg_ticket_badge"
            android:fontFamily="@font/inter_bold"
            android:gravity="center"
            android:importantForAccessibility="no"
            android:includeFontPadding="false"
            android:text="+"
            android:textColor="#A8F0D9"
            android:textSize="39.2sp"
            tools:ignore="HardcodedText" />

        <ImageView
            android:layout_width="137dp"
            android:layout_height="53dp"
            android:layout_gravity="top|end"
            android:layout_marginTop="218.5dp"
            android:layout_marginEnd="16.5dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ticket_pulse" />
    </FrameLayout>

    <LinearLayout
        style="@style/Widget.HyTrack.WarningCard"
        android:tag="guide">

        <TextView
            android:id="@+id/leaveBy"
            style="@style/Text.H2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:lineHeight="29.7sp"
            android:textColor="@color/warning_text"
            android:textSize="22sp"
            tools:text="Berangkat sebelum 08.20" />

        <TextView
            android:id="@+id/leaveText"
            style="@style/Text.P"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/warning_text"
            tools:text="Check-in paling lambat 08.45, 15 menit sebelum praktik dimulai." />
    </LinearLayout>

    <!-- .metrics.ticket-metrics, with the dot-grid accent behind the right edge.
         The negative bottom margin keeps the accent out of the layout, like position: absolute. -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipChildren="false">

        <ImageView
            android:layout_width="86dp"
            android:layout_height="121dp"
            android:layout_gravity="top|end"
            android:layout_marginTop="-9dp"
            android:layout_marginEnd="-23dp"
            android:layout_marginBottom="-70dp"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop"
            android:src="@drawable/decor_dots"
            tools:ignore="ContentDescription" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/ahead"
                    style="@style/Text.Metric"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="3 pasien" />

                <TextView
                    style="@style/Text.MetricLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/sedang_menunggu" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="18dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/wait"
                    style="@style/Text.Metric"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="15–25 mnt" />

                <TextView
                    style="@style/Text.MetricLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/setelah_check_in" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <TextView
        android:id="@+id/showQr"
        style="@style/Widget.HyTrack.Button"
        android:tag="guide"
        android:text="@string/tampilkan_qr_check_in" />

    <TextView
        style="@style/Text.Small.Muted"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/gedung_a_lantai_2_meja_check_in_nestimasi" />

    <include
        android:id="@+id/hyaHelp"
        layout="@layout/view_hya_help" />

    <TextView
        android:id="@+id/cancel"
        style="@style/Widget.HyTrack.TextButton"
        android:text="@string/batalkan_kunjungan" />
</merge>
