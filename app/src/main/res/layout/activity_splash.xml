<?xml version="1.0" encoding="utf-8"?>
<!-- Splash: the HyTrack lockup of the sign-in screens, centred, over the same mint wave. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <ImageView
        android:id="@+id/wave"
        android:layout_width="match_parent"
        android:layout_height="170dp"
        android:layout_gravity="bottom"
        android:alpha="0"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/wave_mint"
        tools:ignore="ContentDescription" />

    <!-- Everything starts transparent; SplashActivity fades it in on the first frame. -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp">

        <ImageView
            android:id="@+id/logo"
            android:layout_width="132dp"
            android:layout_height="99dp"
            android:alpha="0"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter"
            android:src="@drawable/logo_hytrack"
            tools:ignore="ContentDescription" />

        <TextView
            android:id="@+id/name"
            style="@style/Text.Auth"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:alpha="0"
            android:fontFamily="@font/jakarta_bold"
            android:lineHeight="40sp"
            android:text="@string/app_name"
            android:textColor="@color/brand"
            android:textSize="32sp" />

        <TextView
            android:id="@+id/tagline"
            style="@style/Text.Auth"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:alpha="0"
            android:fontFamily="@font/jakarta_semibold"
            android:gravity="center"
            android:letterSpacing="0.08"
            android:lineHeight="16sp"
            android:text="@string/tagline"
            android:textColor="@color/brand_muted"
            android:textSize="11sp" />
    </LinearLayout>
</FrameLayout>
