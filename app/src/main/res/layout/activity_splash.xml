<?xml version="1.0" encoding="utf-8"?>
<!--
  Splash, after the Figma storyboard 43:2. SplashActivity starts with the mark exactly where the
  system splash drew it (centred, 120dp wide), then plays the storyboard: the light-blue band, the
  mark moving aside for the wordmark, the tagline, and the teal band on the way out.
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/splash_bg">

    <com.constanvel.hytracl.Sweep
        android:id="@+id/sweepIn"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no" />

    <!-- Mark + wordmark, at rest as in Figma 43:189. -->
    <LinearLayout
        android:id="@+id/lockup"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintBottom_toTopOf="@id/tagline"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed">

        <!-- The hands turn about the clock's centre, (83.9, 12.4) on the mark's canvas. Raised
             above the wordmark, which comes out from behind it (no background, so no shadow). -->
        <FrameLayout
            android:id="@+id/mark"
            android:layout_width="96.85dp"
            android:layout_height="70.56dp"
            android:contentDescription="@string/app_name"
            android:translationZ="1dp">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:src="@drawable/splash_mark"
                tools:ignore="ContentDescription" />

            <ImageView
                android:id="@+id/hour"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:rotation="157"
                android:src="@drawable/splash_hand_hour"
                android:transformPivotX="83.9dp"
                android:transformPivotY="12.4dp"
                tools:ignore="ContentDescription" />

            <ImageView
                android:id="@+id/minute"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:rotation="70"
                android:src="@drawable/splash_hand_minute"
                android:transformPivotX="83.9dp"
                android:transformPivotY="12.4dp"
                tools:ignore="ContentDescription" />
        </FrameLayout>

        <!-- In dp, not sp: the wordmark is part of the logo and keeps its proportion to the mark. -->
        <TextView
            android:id="@+id/name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            android:fontFamily="@font/inter_bold"
            android:importantForAccessibility="no"
            android:includeFontPadding="false"
            android:letterSpacing="-0.04"
            android:text="@string/app_name"
            android:textColor="@color/brand"
            android:textSize="45dp"
            tools:ignore="SpUsage" />
    </LinearLayout>

    <!-- The start padding matches the spacing after the last letter, so it stays centred. -->
    <TextView
        android:id="@+id/tagline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="34dp"
        android:fontFamily="@font/inter_medium"
        android:letterSpacing="0.23"
        android:lineHeight="18sp"
        android:paddingStart="2.3sp"
        android:text="@string/tagline"
        android:textColor="@color/splash_text"
        android:textSize="10sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/lockup"
        tools:ignore="RtlSymmetry,SmallSp" />

    <com.constanvel.hytracl.Sweep
        android:id="@+id/sweepOut"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no" />
</androidx.constraintlayout.widget.ConstraintLayout>
