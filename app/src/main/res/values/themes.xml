<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- HyTrack is light-only on the web, so the app keeps one light theme. -->
    <style name="Base.Theme.Hytracl" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/primary</item>
        <item name="colorSurface">@color/bg</item>
        <item name="colorOnSurface">@color/text</item>
        <item name="colorControlActivated">@color/primary</item>
        <item name="colorControlHighlight">#1F0B7268</item>
        <item name="android:colorBackground">@color/bg</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:fontFamily">@font/inter</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:textColorHighlight">#330B7268</item>
    </style>

    <style name="Theme.Hytracl" parent="Base.Theme.Hytracl" />

    <!--
      Launcher window (androidx SplashScreen, API 28+): the logo on the app background, drawn by the
      system before the app starts. SplashActivity's first frame has the same logo in the same
      place, so the hand-over shows no flash and no second logo.
    -->
    <style name="Theme.Hytracl.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="postSplashScreenTheme">@style/Theme.Hytracl</item>
    </style>
</resources>
