<?xml version="1.0" encoding="utf-8"?>
<!--
  The patient app frame (components/shell.tsx): demo banner, page header, scrolling content,
  fixed bottom nav and the Hya bubble. Each screen inflates its content into @id/content.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true">

        <!-- The page plus its decoration: the accent sits at the end of the page and scrolls with it. -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_page">

        <!-- .decor-waves / .decor-corner: behind the content, above the bottom bar. -->
        <ImageView
            android:id="@+id/decor"
            android:layout_width="match_parent"
            android:layout_height="170dp"
            android:layout_gravity="bottom"
            android:importantForAccessibility="no"
            android:scaleType="fitXY"
            android:visibility="gone"
            tools:ignore="ContentDescription" />

        <LinearLayout
            android:id="@+id/page"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/demoBanner"
                style="@style/Text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:minHeight="32dp"
                android:paddingStart="@dimen/page_gutter"
                android:paddingTop="8dp"
                android:paddingEnd="@dimen/page_gutter"
                android:paddingBottom="8dp"
                android:text="@string/demo_banner"
                android:textColor="@color/muted"
                android:textSize="10sp" />

            <LinearLayout
                android:id="@+id/header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:divider="@drawable/gap_12"
                android:gravity="center_vertical"
                android:minHeight="@dimen/header_min_height"
                android:orientation="horizontal"
                android:paddingStart="@dimen/page_gutter"
                android:paddingTop="8dp"
                android:paddingEnd="@dimen/page_gutter"
                android:paddingBottom="8dp"
                android:showDividers="middle">

                <ImageView
                    android:id="@+id/back"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="-8dp"
                    android:layout_marginEnd="2dp"
                    android:background="@drawable/bg_back_chip"
                    android:contentDescription="@string/back"
                    android:scaleType="center"
                    android:src="@drawable/ic_back"
                    android:visibility="gone" />

                <include
                    android:id="@+id/headerAvatar"
                    layout="@layout/view_avatar"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/heading"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/title"
                        style="@style/Text.H1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:accessibilityHeading="true"
                        tools:text="Pilih poliklinik" />

                    <TextView
                        android:id="@+id/subtitle"
                        style="@style/Text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:lineHeight="18sp"
                        android:textColor="@color/muted"
                        android:textSize="11sp"
                        tools:text="KUNJUNGAN BARU · 1 / 2" />
                </LinearLayout>

                <!-- .page-header .lockup: logo, name and tagline on the patient home. -->
                <LinearLayout
                    android:id="@+id/lockup"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="56dp"
                        android:layout_height="42dp"
                        android:importantForAccessibility="no"
                        android:scaleType="fitCenter"
                        android:src="@drawable/logo_hytrack"
                        tools:ignore="ContentDescription" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:accessibilityHeading="true"
                            android:fontFamily="@font/inter_bold"
                            android:lineHeight="28sp"
                            android:text="@string/app_name"
                            android:textColor="@color/brand"
                            android:textSize="21sp" />

                        <TextView
                            style="@style/Text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/inter_semibold"
                            android:lineHeight="13sp"
                            android:text="@string/tagline"
                            android:textColor="@color/brand_muted"
                            android:textSize="9sp" />
                    </LinearLayout>
                </LinearLayout>

                <FrameLayout
                    android:id="@+id/bell"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:contentDescription="@string/notifications"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_bell"
                        tools:ignore="ContentDescription" />

                    <View
                        android:id="@+id/unreadDot"
                        android:layout_width="13dp"
                        android:layout_height="13dp"
                        android:layout_gravity="top|end"
                        android:layout_marginTop="7dp"
                        android:layout_marginEnd="7dp"
                        android:background="@drawable/bg_unread_dot"
                        android:visibility="gone" />
                </FrameLayout>

                <ImageView
                    android:id="@+id/close"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/close_hya"
                    android:scaleType="center"
                    android:src="@drawable/ic_close"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- .page-content: flex column, 20px gap. -->
            <LinearLayout
                android:id="@+id/content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:divider="@drawable/gap_20"
                android:orientation="vertical"
                android:paddingStart="@dimen/page_gutter"
                android:paddingTop="16dp"
                android:paddingEnd="@dimen/page_gutter"
                android:paddingBottom="28dp"
                android:showDividers="middle" />
        </LinearLayout>
        </FrameLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- .hya-fab -->
    <FrameLayout
        android:id="@+id/fab"
        android:layout_width="67dp"
        android:layout_height="67dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="15dp"
        android:layout_marginBottom="95dp"
        android:background="@drawable/bg_fab_ring"
        android:clickable="true"
        android:contentDescription="@string/ask_hya"
        android:focusable="true">

        <include
            layout="@layout/view_avatar_large"
            android:layout_width="55dp"
            android:layout_height="55dp"
            android:layout_gravity="center" />
    </FrameLayout>

    <!-- .bottom-nav -->
    <LinearLayout
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="@dimen/bottom_nav_height"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_bottom_nav"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="6dp"
        android:paddingEnd="12dp"
        android:paddingBottom="6dp">

        <include
            android:id="@+id/navHome"
            layout="@layout/view_nav_item"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />

        <include
            android:id="@+id/navVisit"
            layout="@layout/view_nav_item"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />

        <include
            android:id="@+id/navAccount"
            layout="@layout/view_nav_item"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />
    </LinearLayout>

    <!-- Hya's .chat-composer replaces the nav on the Hya screen. -->
    <FrameLayout
        android:id="@+id/footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:visibility="gone" />
</FrameLayout>
