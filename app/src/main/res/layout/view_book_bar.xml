<?xml version="1.0" encoding="utf-8"?>
<!-- Navigasi dan aksi (Figma 22:79): the booking button pinned above the system bar. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipToPadding="false"
    android:paddingStart="@dimen/page_gutter"
    android:paddingTop="14dp"
    android:paddingEnd="@dimen/page_gutter"
    android:paddingBottom="14dp">

    <LinearLayout
        android:id="@+id/book"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="@drawable/bg_btn_book"
        android:clickable="true"
        android:elevation="4dp"
        android:focusable="true"
        android:gravity="center"
        android:orientation="horizontal"
        android:tag="guide">

        <TextView
            android:id="@+id/label"
            style="@style/Text.Figma"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/inter_semibold"
            android:lineHeight="22.4sp"
            android:textColor="@color/white"
            android:textSize="16sp"
            tools:text="Ambil antrean" />

        <ImageView
            android:id="@+id/arrow"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginStart="10dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_arrow"
            android:tint="@color/white"
            tools:ignore="ContentDescription,UseAppTint" />
    </LinearLayout>
</FrameLayout>
