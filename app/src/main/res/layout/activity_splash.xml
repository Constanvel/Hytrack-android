<?xml version="1.0" encoding="utf-8"?>
<!--
  Splash: the logo sits exactly where the system splash drew it (centre, 132×97dp), so the
  hand-over is seamless; the name, tagline and mint wave then fade in around it.
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <ImageView
        android:id="@+id/wave"
        android:layout_width="0dp"
        android:layout_height="170dp"
        android:alpha="0"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/wave_mint"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        tools:ignore="ContentDescription" />

    <ImageView
        android:id="@+id/logo"
        android:layout_width="132dp"
        android:layout_height="97dp"
        android:contentDescription="@string/app_name"
        android:scaleType="fitCenter"
        android:src="@drawable/logo_hytrack"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/name"
        style="@style/Text.Auth"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:alpha="0"
        android:fontFamily="@font/jakarta_bold"
        android:importantForAccessibility="no"
        android:lineHeight="40sp"
        android:text="@string/app_name"
        android:textColor="@color/brand"
        android:textSize="32sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/logo" />

    <TextView
        android:id="@+id/tagline"
        style="@style/Text.Auth"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:alpha="0"
        android:fontFamily="@font/jakarta_semibold"
        android:gravity="center"
        android:letterSpacing="0.08"
        android:lineHeight="16sp"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:text="@string/tagline"
        android:textColor="@color/brand_muted"
        android:textSize="11sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/name" />
</androidx.constraintlayout.widget.ConstraintLayout>
