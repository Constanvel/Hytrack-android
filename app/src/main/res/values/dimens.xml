<?xml version="1.0" encoding="utf-8"?>
<!-- CSS px map 1:1 to dp (the web layout is designed for a ~393-412px wide phone). -->
<resources>
    <dimen name="page_gutter">24dp</dimen>
    <dimen name="radius">20dp</dimen>
    <dimen name="header_min_height">72dp</dimen>
    <dimen name="bottom_nav_height">80dp</dimen>
    <!--
      Space under the page content (which adds its own 28dp): bottom nav (80) plus room for the
      Hya bubble, whose top sits 82dp above the nav. 144 + 28 leaves a 92dp strip above the nav,
      enough for the bubble with a 10dp margin, without the extra empty band at the page end.
    -->
    <dimen name="shell_bottom_space">144dp</dimen>
    <dimen name="button_height">52dp</dimen>
    <dimen name="touch_target">44dp</dimen>
</resources>
