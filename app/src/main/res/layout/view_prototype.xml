<?xml version="1.0" encoding="utf-8"?>
<!-- "Mode prototype" card of the web sign-in pages (auth.css .auth-prototype), filled in by prototypeCard(). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_prototype"
    android:divider="@drawable/gap_12"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="14dp"
    android:paddingEnd="16dp"
    android:paddingBottom="14dp"
    android:showDividers="middle">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <CheckBox
            android:id="@+id/toggle"
            android:layout_width="40dp"
            android:layout_height="24dp"
            android:background="@drawable/bg_prototype_switch"
            android:button="@null"
            android:minWidth="0dp"
            android:minHeight="0dp" />

        <LinearLayout
            android:id="@+id/caption"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:divider="@drawable/gap_2"
            android:importantForAccessibility="noHideDescendants"
            android:orientation="vertical"
            android:showDividers="middle">

            <TextView
                style="@style/Text.Auth.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/mode_prototype" />

            <TextView
                android:id="@+id/hint"
                style="@style/Text.Auth"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:lineHeight="17sp"
                android:textColor="@color/auth_benefit_text"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Masuk sebagai: a two-column grid, shown while the mode is on. -->
    <LinearLayout
        android:id="@+id/choices"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:divider="@drawable/gap_8"
        android:orientation="vertical"
        android:showDividers="middle"
        android:visibility="gone" />
</LinearLayout>
