<?xml version="1.0" encoding="utf-8"?>
<!-- Antrean saya (features/patient/visit.tsx: Queue, stages "waiting" / "serving"). No page gap. -->
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:orientation="vertical"
    tools:parentTag="android.widget.LinearLayout">

    <!-- .connection-row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="14dp"
        android:accessibilityLiveRegion="polite"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            style="@style/Text.Strong"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="● Terhubung"
            android:textColor="@color/primary"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/synced"
            style="@style/Text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:textColor="@color/muted"
            android:textSize="11sp"
            tools:text="Diperbarui 16.47" />
    </LinearLayout>

    <!-- .hero.queue-hero -->
    <LinearLayout
        style="@style/Widget.HyTrack.Hero"
        android:minHeight="288dp"
        android:paddingStart="22dp"
        android:paddingTop="18dp"
        android:paddingEnd="22dp"
        android:paddingBottom="16dp"
        android:showDividers="none"
        android:tag="guide">

        <TextView
            android:id="@+id/eyebrow"
            style="@style/Text.Hero.Eyebrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="SUDAH CHECK-IN" />

        <TextView
            android:id="@+id/headline"
            style="@style/Text.Hero.H2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:lineHeight="33.6sp"
            android:textSize="24sp"
            tools:text="Menunggu giliran" />

        <TextView
            android:id="@+id/ticket"
            style="@style/Text.Ticket"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:lineHeight="85.8sp"
            android:textColor="@color/white"
            android:textSize="66sp"
            tools:text="A-027" />

        <TextView
            android:id="@+id/ahead"
            style="@style/Text.P"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:lineHeight="28sp"
            android:textColor="@color/white"
            android:textSize="17sp"
            tools:text="3 pasien lagi sebelum Anda" />

        <View
            style="@style/Widget.HyTrack.Hr"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="8dp"
            android:background="@color/hero_rule" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.2"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/wait"
                    style="@style/Text.Metric"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:lineHeight="35sp"
                    android:textColor="@color/white"
                    android:textSize="25sp"
                    tools:text="15–25 mnt" />

                <TextView
                    style="@style/Text.Small"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="perkiraan tunggu"
                    android:textColor="@color/hero_eyebrow" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="18dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/serving"
                    style="@style/Text.Metric"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:lineHeight="35sp"
                    android:textColor="@color/white"
                    android:textSize="25sp"
                    tools:text="A-023" />

                <TextView
                    style="@style/Text.Small"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="sedang dilayani"
                    android:textColor="@color/hero_eyebrow" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- .queue-location -->
    <LinearLayout
        style="@style/Widget.HyTrack.Stack"
        android:layout_marginTop="24dp">

        <TextView
            android:id="@+id/locationEyebrow"
            style="@style/Text.Eyebrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            tools:text="TUNGGU DI SINI" />

        <TextView
            android:id="@+id/clinic"
            style="@style/Text.H2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:lineHeight="28.4sp"
            android:textSize="21sp"
            tools:text="Poli Penyakit Dalam" />

        <TextView
            android:id="@+id/room"
            style="@style/Text.P.Muted"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            tools:text="Ruang A-204 · Gedung A, lantai 2" />

        <LinearLayout
            android:id="@+id/directions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_btn_secondary"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:minHeight="50dp"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <TextView
                style="@style/Text.Strong"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Lihat petunjuk ruangan"
                android:textColor="@color/primary" />

            <FrameLayout
                android:layout_width="24dp"
                android:layout_height="24dp">

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_arrow"
                    tools:ignore="ContentDescription" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>

    <TextView
        style="@style/Text.P.Muted"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="Tetap di dekat ruang. Dengarkan juga\npanggilan petugas rumah sakit." />

    <include
        android:id="@+id/share"
        layout="@layout/view_row_link"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp" />

    <include
        android:id="@+id/hyaHelp"
        layout="@layout/view_hya_help" />

    <include
        android:id="@+id/demo"
        layout="@layout/view_demo_controls" />
</merge>
