<?xml version="1.0" encoding="utf-8"?>
<!-- .avatar-large: 5px white border + 1px #d6e6de ring -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item><shape android:shape="oval">
    <solid android:color="@color/avatar_ring" />
</shape></item>
    <item android:top="1dp" android:left="1dp" android:right="1dp" android:bottom="1dp"><shape android:shape="oval">
    <solid android:color="#FFFFFF" />
</shape></item>
</layer-list>
