<?xml version="1.0" encoding="utf-8"?>
<!-- .clinic-list .row-link (Figma 43:2 frame 02): marked card, mint while pressed. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <layer-list>
            <item><shape>
                <solid android:color="@color/pale" />
                <stroke android:width="1dp" android:color="@color/card_border" />
                <corners android:radius="22dp" />
            </shape></item>
            <item android:width="4dp" android:height="32dp" android:gravity="top|start" android:top="22dp">
        <shape>
            <solid android:color="@color/marker" />
            <corners android:radius="2dp" />
        </shape>
            </item>
        </layer-list>
    </item>
    <item android:drawable="@drawable/bg_card_marked" />
</selector>
