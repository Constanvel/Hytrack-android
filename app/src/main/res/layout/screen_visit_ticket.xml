<?xml version="1.0" encoding="utf-8"?>
<!-- Tiket kunjungan (features/patient/visit.tsx: Visit, stage "booked"). -->
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:orientation="vertical"
    tools:parentTag="android.widget.LinearLayout">

    <TextView
        style="@style/Widget.HyTrack.Notice"
        android:text="✓ Antrean berhasil diambil" />

    <!-- .card.ticket-card -->
    <LinearLayout
        style="@style/Widget.HyTrack.Card"
        android:paddingStart="22dp"
        android:paddingTop="22dp"
        android:paddingEnd="22dp"
        android:paddingBottom="22dp">

        <TextView
            style="@style/Text.Eyebrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="NOMOR ANTREAN ANDA" />

        <TextView
            android:id="@+id/ticket"
            style="@style/Text.Ticket"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="A-027" />

        <TextView
            android:id="@+id/patient"
            style="@style/Text.H3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="Siti Aminah" />

        <View style="@style/Widget.HyTrack.Hr" />

        <TextView
            android:id="@+id/clinic"
            style="@style/Text.H3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="Penyakit Dalam" />

        <TextView
            android:id="@+id/schedule"
            style="@style/Text.P.Muted"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="dr. Rina Kusuma, Sp.PD\nMinggu, 15 November 2026 · 09.00–12.00" />
    </LinearLayout>

    <LinearLayout
        style="@style/Widget.HyTrack.WarningCard"
        android:tag="guide">

        <TextView
            android:id="@+id/leaveBy"
            style="@style/Text.H2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:lineHeight="29.7sp"
            android:textColor="@color/warning_text"
            android:textSize="22sp"
            tools:text="Berangkat sebelum 08.20" />

        <TextView
            android:id="@+id/leaveText"
            style="@style/Text.P"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/warning_text"
            tools:text="Check-in paling lambat 08.45, 15 menit sebelum praktik dimulai." />
    </LinearLayout>

    <!-- .metrics.ticket-metrics, with the dot-grid accent behind the right edge.
         The negative bottom margin keeps the accent out of the layout, like position: absolute. -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipChildren="false">

        <ImageView
            android:layout_width="86dp"
            android:layout_height="121dp"
            android:layout_gravity="top|end"
            android:layout_marginTop="-9dp"
            android:layout_marginEnd="-23dp"
            android:layout_marginBottom="-70dp"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop"
            android:src="@drawable/decor_dots"
            tools:ignore="ContentDescription" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/ahead"
                    style="@style/Text.Metric"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="3 pasien" />

                <TextView
                    style="@style/Text.MetricLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="sedang menunggu" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="18dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/wait"
                    style="@style/Text.Metric"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="15–25 mnt" />

                <TextView
                    style="@style/Text.MetricLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="setelah check-in" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <TextView
        android:id="@+id/showQr"
        style="@style/Widget.HyTrack.Button"
        android:tag="guide"
        android:text="Tampilkan QR check-in" />

    <TextView
        style="@style/Text.Small.Muted"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Gedung A, lantai 2 · Meja check-in\nEstimasi berubah mengikuti pelayanan." />

    <include
        android:id="@+id/hyaHelp"
        layout="@layout/view_hya_help" />

    <TextView
        android:id="@+id/cancel"
        style="@style/Widget.HyTrack.TextButton"
        android:text="Batalkan kunjungan" />
</merge>
