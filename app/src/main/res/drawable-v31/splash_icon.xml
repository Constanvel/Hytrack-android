<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ draws the splash icon about 1.76× larger than its canvas (measured on API 37), so the
  logo is 75×55dp here to show at the 132×97dp SplashActivity uses. On the 288dp canvas,
  inside the 192dp circle Android 12+ masks the icon with.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:width="288dp"
        android:height="288dp">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
    <item
        android:width="75dp"
        android:height="55dp"
        android:drawable="@drawable/logo_hytrack"
        android:gravity="center" />
</layer-list>
