<?xml version="1.0" encoding="utf-8"?>
<!-- Sign-up (features/auth/register.tsx, Figma 00b · Sign up): the compact auth frame. -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="170dp"
            android:layout_gravity="bottom"
            android:layout_marginBottom="-24dp"
            android:importantForAccessibility="no"
            android:scaleType="fitXY"
            android:src="@drawable/wave_mint"
            tools:ignore="ContentDescription" />

        <LinearLayout
            android:id="@+id/main"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:divider="@drawable/gap_24"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="20dp"
            android:paddingEnd="24dp"
            android:paddingBottom="116dp"
            android:showDividers="middle">

            <include
                android:id="@+id/identity"
                layout="@layout/view_auth_identity" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:divider="@drawable/gap_16"
                android:orientation="vertical"
                android:showDividers="middle">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:divider="@drawable/gap_12"
                    android:orientation="vertical"
                    android:showDividers="middle">

                    <include
                        android:id="@+id/name"
                        layout="@layout/view_auth_field" />

                    <include
                        android:id="@+id/phone"
                        layout="@layout/view_auth_field" />

                    <include
                        android:id="@+id/password"
                        layout="@layout/view_auth_field" />

                    <include
                        android:id="@+id/confirm"
                        layout="@layout/view_auth_field" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:divider="@drawable/gap_7"
                    android:orientation="vertical"
                    android:showDividers="middle">

                    <!-- .auth-consent -->
                    <CheckBox
                        android:id="@+id/terms"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@null"
                        android:button="@drawable/bg_checkbox"
                        app:buttonTint="@null"
                        app:useMaterialThemeColors="false"
                        android:fontFamily="@font/inter_regular"
                        android:gravity="top"
                        android:includeFontPadding="false"
                        android:lineHeight="17sp"
                        android:minHeight="0dp"
                        android:paddingStart="10dp"
                        android:textColor="@color/brand_muted"
                        android:textSize="12sp"
                        tools:text="Saya menyetujui Syarat &amp; Ketentuan" />

                    <TextView
                        android:id="@+id/termsError"
                        style="@style/Text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:accessibilityLiveRegion="assertive"
                        android:fontFamily="@font/inter_semibold"
                        android:textColor="@color/error"
                        android:textSize="12sp"
                        android:visibility="gone" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:divider="@drawable/gap_8"
                    android:orientation="vertical"
                    android:showDividers="middle">

                    <TextView
                        android:id="@+id/submit"
                        style="@style/Widget.HyTrack.AuthSubmit"
                        android:layout_height="52dp"
                        android:text="@string/buat_akun" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:paddingTop="10dp"
                        android:paddingBottom="10dp">

                        <TextView
                            style="@style/Text.Auth"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:lineHeight="20sp"
                            android:text="@string/sudah_punya_akun"
                            android:textColor="@color/brand_muted"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/switchLink"
                            style="@style/Text.Auth.Link"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="5dp"
                            android:text="@string/masuk" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:divider="@drawable/gap_16"
                android:orientation="vertical"
                android:showDividers="middle">

                <TextView
                    android:id="@+id/contact"
                    style="@style/Text.Auth.Link"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter_medium"
                    android:gravity="center"
                    android:lineHeight="18sp"
                    android:text="@string/butuh_bantuan_hubungi_petugas"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/contactNotice"
                    style="@style/Widget.HyTrack.Notice"
                    android:text="@string/account_help"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</androidx.core.widget.NestedScrollView>
