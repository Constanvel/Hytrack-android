<?xml version="1.0" encoding="utf-8"?>
<!-- Tanggal (Figma 22:47): weekday above the bold date; primary when selected. Width set in code. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_date"
    android:clickable="true"
    android:divider="@drawable/gap_2"
    android:focusable="true"
    android:gravity="center"
    android:minHeight="68dp"
    android:orientation="vertical"
    android:padding="12dp"
    android:showDividers="middle">

    <TextView
        android:id="@+id/day"
        style="@style/Text.Figma.Muted"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/inter_medium"
        android:lineHeight="18.2sp"
        android:maxLines="1"
        android:textSize="13sp"
        tools:text="Jum" />

    <TextView
        android:id="@+id/label"
        style="@style/Text.Figma"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/inter_bold"
        android:lineHeight="23.8sp"
        android:maxLines="1"
        android:textSize="17sp"
        tools:text="4 Des" />
</LinearLayout>
