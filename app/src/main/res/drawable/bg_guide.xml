<?xml version="1.0" encoding="utf-8"?>
<!-- .guide-hint: 1px border, 4px primary left border, 16px radius -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item><shape>
    <solid android:color="@color/primary" />
    <corners android:radius="16dp" />
</shape></item>
    <item android:left="4dp"><shape>
    <solid android:color="@color/border" />
    <corners android:topLeftRadius="12dp" android:topRightRadius="16dp" android:bottomRightRadius="16dp" android:bottomLeftRadius="12dp" />
</shape></item>
    <item android:left="4dp" android:top="1dp" android:right="1dp" android:bottom="1dp"><shape>
    <solid android:color="#FFFFFF" />
    <corners android:topLeftRadius="12dp" android:topRightRadius="15dp" android:bottomRightRadius="15dp" android:bottomLeftRadius="12dp" />
</shape></item>
</layer-list>
