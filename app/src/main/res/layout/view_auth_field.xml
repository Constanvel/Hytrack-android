<?xml version="1.0" encoding="utf-8"?>
<!-- AuthInput (.auth-field): label, 52px input with optional phone icon / eye toggle, error. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:divider="@drawable/gap_7"
    android:orientation="vertical"
    android:showDividers="middle">

    <TextView
        android:id="@+id/label"
        style="@style/Text.Auth.Label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:labelFor="@id/input"
        tools:text="Nomor ponsel" />

    <LinearLayout
        android:id="@+id/box"
        style="@style/Widget.HyTrack.AuthField">

        <ImageView
            android:id="@+id/icon"
            android:layout_width="31dp"
            android:layout_height="20dp"
            android:layout_marginEnd="8dp"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_phone"
            android:visibility="gone"
            tools:ignore="ContentDescription" />

        <EditText
            android:id="@+id/input"
            style="@style/Widget.HyTrack.AuthInput"
            android:importantForAutofill="yes"
            tools:hint="+62 123-4567-8910" />

        <ImageView
            android:id="@+id/eye"
            android:layout_width="43dp"
            android:layout_height="44dp"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="-6dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/tampilkan_kata_sandi"
            android:paddingStart="6dp"
            android:paddingTop="12dp"
            android:paddingEnd="6dp"
            android:paddingBottom="12dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_eye"
            android:visibility="gone" />
    </LinearLayout>

    <TextView
        android:id="@+id/error"
        style="@style/Text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:accessibilityLiveRegion="assertive"
        android:fontFamily="@font/jakarta_semibold"
        android:textColor="@color/error"
        android:textSize="12sp"
        android:visibility="gone" />
</LinearLayout>
