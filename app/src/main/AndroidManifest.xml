<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Staff Scan QR kedatangan reads ticket QRs; a device without a camera uses the ticket number. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Hytracl">
        <!-- Launcher entry; noHistory so it never sits in the back stack. -->
        <activity
            android:name=".SplashActivity"
            android:exported="true"
            android:noHistory="true"
            android:theme="@style/Theme.Hytracl.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".LoginActivity" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".RegisterActivity" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".RegisterOtpActivity" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".HomeActivity" />
        <activity android:name=".AccountActivity" />
        <activity android:name=".HistoryActivity" />
        <activity android:name=".NotificationsActivity" />
        <activity android:name=".ClinicsActivity" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".DoctorsActivity" />
        <activity android:name=".VisitActivity" />
        <activity android:name=".CheckInActivity" />
        <activity android:name=".CompanionAccessActivity" />
        <activity android:name=".CompanionListActivity" />
        <activity android:name=".CompanionMonitorActivity" />
        <!-- Companion invitation links (Local.INVITE_HOST) open here. -->
        <activity
            android:name=".CompanionInviteActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data android:scheme="https" />
                <data android:host="hytrack.demo" />
                <data android:pathPrefix="/pantauan/" />
            </intent-filter>
        </activity>
        <activity android:name=".PatientDataActivity" />
        <activity android:name=".PatientFormActivity" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".HyaActivity" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".HelpActivity" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".CheckInGuideActivity" />
        <activity android:name=".QueueGuideActivity" />
        <activity android:name=".DirectionsActivity" />
        <activity android:name=".StaffActivity" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".ManagementActivity" android:windowSoftInputMode="adjustResize" />
    </application>

</manifest>
