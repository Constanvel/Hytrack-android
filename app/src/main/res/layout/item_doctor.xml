<?xml version="1.0" encoding="utf-8"?>
<!-- Dokter terpilih (Figma 22:57): 2dp primary border, schedule, estimates and status. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_doctor"
    android:divider="@drawable/gap_10"
    android:orientation="vertical"
    android:padding="20dp"
    android:showDividers="middle">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/name"
            style="@style/Text.Figma"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/inter_bold"
            android:lineHeight="26.6sp"
            android:textSize="19sp"
            tools:text="dr. Rina Kusuma, Sp.PD" />

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="12dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_check"
            tools:ignore="ContentDescription" />
    </LinearLayout>

    <TextView
        android:id="@+id/schedule"
        style="@style/Text.Figma.Muted"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:lineHeight="21sp"
        android:textSize="15sp"
        tools:text="Penyakit Dalam\nJumat, 4 Des 2026 · 09.00–12.00" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/border" />

    <!-- Estimasi jadwal: two columns, 12dp gap. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:divider="@drawable/gap_12"
        android:orientation="horizontal"
        android:showDividers="middle">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:divider="@drawable/gap_12"
            android:orientation="vertical"
            android:showDividers="middle">

            <TextView
                style="@style/Text.Figma.Muted"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineHeight="16.8sp"
                android:text="@string/perkiraan_tunggu"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/wait"
                style="@style/Text.Figma"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_bold"
                android:lineHeight="26.6sp"
                android:textSize="19sp"
                tools:text="35–50 menit" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:divider="@drawable/gap_12"
            android:orientation="vertical"
            android:showDividers="middle">

            <TextView
                style="@style/Text.Figma.Muted"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineHeight="16.8sp"
                android:text="@string/sisa_kuota"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/quota"
                style="@style/Text.Figma"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_bold"
                android:lineHeight="26.6sp"
                android:textSize="19sp"
                tools:text="18 pasien" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/status"
        style="@style/Text.Figma.Notice"
        tools:text="Jadwal dipilih · 09.00–12.00" />
</LinearLayout>
