<?xml version="1.0" encoding="utf-8"?>
<!-- GuideHint (.guide-hint): step counter, progress, title, text and actions. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_guide"
    android:divider="@drawable/gap_8"
    android:orientation="vertical"
    android:paddingStart="19dp"
    android:paddingTop="16dp"
    android:paddingEnd="16dp"
    android:paddingBottom="16dp"
    android:showDividers="middle">

    <TextView
        android:id="@+id/guideStep"
        style="@style/Text.Eyebrow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        tools:text="PANDUAN · LANGKAH 1 DARI 7" />

    <LinearLayout
        android:id="@+id/guideProgress"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:divider="@drawable/gap_4"
        android:orientation="horizontal"
        android:showDividers="middle" />

    <TextView
        android:id="@+id/guideTitle"
        style="@style/Text.H2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:accessibilityHeading="true"
        android:lineHeight="23sp"
        android:textSize="17sp"
        tools:text="Pastikan nama pasien benar" />

    <TextView
        android:id="@+id/guideText"
        style="@style/Text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:lineHeight="22.4sp"
        tools:text="Nama yang ditandai adalah pasien yang akan berobat." />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/guideOk"
            style="@style/Widget.HyTrack.Button"
            android:layout_width="wrap_content"
            android:minHeight="44dp"
            android:paddingStart="24dp"
            android:paddingTop="0dp"
            android:paddingEnd="24dp"
            android:paddingBottom="0dp"
            android:text="@string/mengerti" />

        <TextView
            android:id="@+id/guideSkip"
            style="@style/Widget.HyTrack.TextButton"
            android:layout_marginStart="16dp"
            android:text="@string/lewati_panduan" />
    </LinearLayout>
</LinearLayout>
