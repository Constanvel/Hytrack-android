<?xml version="1.0" encoding="utf-8"?>
<!-- .auth-switch-toggle input: 40×24 track, 18dp knob 3dp from its side. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <layer-list>
            <item>
                <shape>
                    <corners android:radius="12dp" />
                    <solid android:color="@color/brand" />
                </shape>
            </item>
            <item android:width="18dp" android:height="18dp" android:gravity="center_vertical|end" android:right="3dp">
                <shape android:shape="oval">
                    <solid android:color="@color/white" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item>
                <shape>
                    <corners android:radius="12dp" />
                    <solid android:color="#C5D3CE" />
                </shape>
            </item>
            <item android:width="18dp" android:height="18dp" android:gravity="center_vertical|start" android:left="3dp">
                <shape android:shape="oval">
                    <solid android:color="@color/white" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
