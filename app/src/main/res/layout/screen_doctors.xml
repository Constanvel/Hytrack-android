<?xml version="1.0" encoding="utf-8"?>
<!-- Dokter & jadwal (features/patient/booking.tsx: DoctorSchedule). -->
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:orientation="vertical"
    tools:parentTag="android.widget.LinearLayout">

    <TextView
        android:id="@+id/clinic"
        style="@style/Widget.HyTrack.Notice"
        tools:text="Penyakit Dalam · Ruang A-204 · Gedung A, lantai 2" />

    <TextView
        style="@style/Text.H2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:accessibilityHeading="true"
        android:text="Pilih dokter &amp; jadwal" />

    <LinearLayout
        android:id="@+id/empty"
        style="@style/Widget.HyTrack.Card.Empty"
        android:visibility="gone">

        <TextView
            style="@style/Text.H3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Jadwal belum tersedia" />

        <TextView
            style="@style/Text.P.Muted"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Belum ada dokter yang praktik di poliklinik ini." />

        <TextView
            android:id="@+id/otherClinic"
            style="@style/Widget.HyTrack.Button.Secondary"
            android:text="Pilih poliklinik lain" />
    </LinearLayout>

    <!-- .date-grid: three columns, 12px gap. -->
    <LinearLayout
        android:id="@+id/dates"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:divider="@drawable/gap_12"
        android:orientation="horizontal"
        android:showDividers="middle" />

    <LinearLayout
        android:id="@+id/doctors"
        style="@style/Widget.HyTrack.Stack"
        android:divider="@drawable/gap_14" />

    <LinearLayout
        android:id="@+id/notYet"
        style="@style/Widget.HyTrack.WarningCard">

        <TextView
            style="@style/Text.Strong"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Antrean belum diambil"
            android:textColor="@color/warning_text" />

        <TextView
            style="@style/Text.Small"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nomor diterbitkan setelah Anda menekan Ambil antrean. Maks. 1 kunjungan aktif."
            android:textColor="@color/warning_text" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/book"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_btn_primary"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:minHeight="52dp"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:tag="guide">

        <TextView
            android:id="@+id/bookLabel"
            style="@style/Text.Strong"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/white"
            tools:text="Ambil antrean" />

        <!-- <Icon name="arrow" className="on-dark" />: the arrow inverted to white. -->
        <FrameLayout
            android:id="@+id/bookArrow"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="12dp">

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_arrow"
                android:tint="@color/white"
                tools:ignore="ContentDescription,UseAppTint" />
        </FrameLayout>
    </LinearLayout>
</merge>
